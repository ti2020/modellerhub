# Copy to .env for local development. On Railway, set these in the service's Variables tab.

# MySQL connection. On Railway use: ${{MySQL.MYSQL_URL}}
DATABASE_URL=mysql://user:password@localhost:3306/modellerhub

# Long random string (32+ characters) used to sign admin sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Google OAuth client — Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google accounts allowed into /admin (comma-separated)
ADMIN_EMAILS=you@gmail.com

# Public address of the site, no trailing slash (e.g. https://modellerhub.up.railway.app)
# Leave empty locally.
PUBLIC_URL=
